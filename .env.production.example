# Salin ke .env di server, lalu isi MAIL_PASSWORD. Jangan di-commit.
APP_NAME=AMIRA
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.amiraedu.com
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

# Database SQLite di database/database.sqlite (dibuat saat pemasangan).
DB_CONNECTION=sqlite
DB_BUSY_TIMEOUT=5000
DB_JOURNAL_MODE=wal
DB_SYNCHRONOUS=normal

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

# Email untuk "lupa kata sandi". Buat akun email di cPanel (misal admin@amiraedu.com).
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.amiraedu.com
MAIL_PORT=465
MAIL_USERNAME=admin@amiraedu.com
# Isi dengan kata sandi akun email di atas (pakai tanda kutip bila ada spasi atau #).
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=admin@amiraedu.com
MAIL_FROM_NAME="${APP_NAME}"

AMIRA_MATERIAL_CHAR_BUDGET=30000
AMIRA_HISTORY_MESSAGES=20
AMIRA_GROQ_RPM=25
AMIRA_STUDENT_RPM=10
